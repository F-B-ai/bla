{
  "expo": {
    "name": "ESSĒRE",
    "slug": "essere-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.essere.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Necessario per i test posturali e per registrare foto e video degli esercizi.",
        "NSPhotoLibraryUsageDescription": "Per caricare foto per i test posturali.",
        "NSMicrophoneUsageDescription": "Per registrare l'audio nei video degli esercizi."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.essere.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./src/assets/icon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-dev-client",
      "expo-image-picker",
      "expo-notifications"
    ],
    "updates": {
      "url": "https://u.expo.dev/"
    },
    "extra": {
      "eas": {}
    }
  }
}