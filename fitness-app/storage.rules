rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Academy content
    match /academy/{courseId}/{folder}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Postural images
    match /postural/{studentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // BIA documents
    match /bia/{studentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Nutrition team attachments
    match /nutritionTeam/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Body composition images
    match /bodycomp/{studentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // User avatars
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Exercise videos
    match /exercise-videos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
