rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Solo il titolare può elencare ed eliminare i file ovunque
    // (necessario per lo strumento di gestione spazio)
    function isOwner() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }
    match /{allPaths=**} {
      allow read, write: if isOwner();
    }

    // Academy content
    match /academy/{courseId}/{folder}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Postural images
    match /postural/{studentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // BIA documents
    match /bia/{studentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Nutrition team attachments
    match /nutritionTeam/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Body composition images
    match /bodycomp/{studentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // User avatars
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Exercise videos
    match /exercise-videos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Content uploads (video, audio, pdf)
    match /content/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
