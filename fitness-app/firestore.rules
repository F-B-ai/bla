rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwner() {
      return isAuthenticated() && getUserRole() == 'owner';
    }

    function isOwnerOrManager() {
      return isAuthenticated() && getUserRole() in ['owner', 'manager'];
    }

    function isStaff() {
      return isAuthenticated() && getUserRole() in ['owner', 'manager', 'collaborator'];
    }

    // Check-in accessi palestra (QR/codice alla reception)
    match /checkins/{checkinId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }

    // Stato ESSĒRE (check-in mente-corpo quotidiano)
    match /wellnessChecks/{checkId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }

    // Consensi privacy (GDPR art. 9): ognuno scrive SOLO i propri;
    // lo staff puo' leggerli (per sapere cosa puo' fare sui dati
    // dell'allievo); mai modificare i consensi di un altro.
    match /consents/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isStaff()
      );
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Log costi/uso AI: scrive SOLO il gateway (Admin SDK).
    // L'owner/manager li legge per il cruscotto costi.
    match /aiUsage/{docId} {
      allow read: if isOwnerOrManager();
      allow write: if false;
    }

    // ============================================================
    // DIGITAL HUMAN TWIN — log eventi append-only (M3, doc 02 §3.2)
    // Fase 1 (transitoria): i client possono fare SOLO create su una
    // whitelist di tipi, con validazione dura. update/delete negati a
    // tutti: le correzioni sono un nuovo evento `event.corrected` con
    // campo supersedes. In Fase 2 anche il create passera' dal gateway.
    // ============================================================
    function myPersonId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.person_id;
    }

    match /human_events/{eventId} {
      // Lettura: staff tutto (vista coach); l'allievo solo la propria storia
      allow read: if isAuthenticated() && (
        isStaff() || resource.data.person_id == myPersonId()
      );
      allow create: if isAuthenticated()
        && request.resource.data.schema_version == 1
        && request.resource.data.type in [
          'wellness.checkin_submitted', 'breathing.session_completed',
          'gym.checkin',
          'workout.started', 'workout.completed', 'workout.abandoned',
          'body.measurement_recorded', 'body.composition_estimated',
          'posture.assessed', 'movement.gait_assessed', 'event.corrected'
        ]
        && request.resource.data.ts is timestamp
        && request.resource.data.ts < request.time + duration.value(5, 'm')
        && request.resource.data.actor_id == request.auth.uid
        && (isStaff() || request.resource.data.person_id == myPersonId());
      // Append-only: mai riscrivere la storia
      allow update, delete: if false;
    }

    // Stati derivati del twin (scritti SOLO dal Brain notturno via
    // Admin SDK): lo staff legge tutto (coda del mattino), l'allievo
    // legge solo il proprio. Nessun client scrive mai.
    match /twins/{personId} {
      allow read: if isAuthenticated() && (
        isStaff() || personId == myPersonId()
      );
      allow write: if false;
    }

    // Config di istanza (licenza white-label): sola lettura dai client,
    // scrittura solo dal fornitore via service account (Admin SDK).
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Eccezioni scrivibili dall'owner: info per l'Assistente e chiave AI
    match /config/assistantInfo {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }
    match /config/aiKey {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // Users collection — M0 hardening:
    // - lettura: il proprio documento, lo staff (che gestisce gli allievi),
    //   oppure i profili dello staff (gli allievi devono vedere nome/contatti
    //   di coach e titolare per chat e pagamenti — MAI i documenti di altri
    //   allievi, che contengono note mediche e obiettivi).
    // - update: il proprietario NON puo' toccare ruolo, commissioni o
    //   assegnazioni (anti scalata di privilegi); owner/manager si'.
    //   L'eccezione hasOnly(['assignedStudents']) serve al flusso inviti
    //   (l'allievo appena registrato si aggiunge alla lista del coach).
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isStaff() ||
        resource.data.role in ['owner', 'manager', 'collaborator']
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isOwnerOrManager() ||
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['role', 'commissionPercentage', 'managerCommissionPercentage',
             'coachCommissionPercentage', 'managedPassword', 'person_id']
          )) ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['assignedStudents']) ||
        // person_id del twin (M3, doc 02 §6.1): SET-ONCE — lo scrive
        // self o staff la prima volta, poi e' immutabile per tutti
        // tranne owner/manager (identita' stabile = base del twin)
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['person_id']) &&
          !('person_id' in resource.data) &&
          (request.auth.uid == userId || isStaff()))
      );
      allow delete: if isStaff();
    }

    // Student invites
    match /studentInvites/{inviteId} {
      allow read: if true;
      allow create: if isStaff();
      allow update: if isAuthenticated();
      allow delete: if isOwnerOrManager();
    }

    // Training programs
    match /trainingPrograms/{programId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Workout plans
    match /workoutPlans/{planId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Exercise library
    match /exerciseLibrary/{exerciseId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Sessions
    match /sessions/{sessionId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // Nutritionist appointments - dati sensibili
    match /nutritionistAppointments/{appointmentId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // Body measurements - dati sanitari sensibili
    match /bodyMeasurements/{measurementId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // BIA documents - dati sanitari sensibili
    match /biaDocuments/{docId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Workout logs
    match /workoutLogs/{logId} {
      allow read: if isAuthenticated() && (
        isStaff() || resource.data.studentId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isStaff() || request.resource.data.studentId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isStaff() || resource.data.studentId == request.auth.uid
      );
      allow delete: if isStaff();
    }

    // Payment plans - dati finanziari sensibili
    match /paymentPlans/{planId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isAuthenticated();
      allow delete: if isOwnerOrManager();
    }

    // Collaborator earnings
    match /collaboratorEarnings/{earningId} {
      allow read: if isOwnerOrManager() || resource.data.collaboratorId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isOwnerOrManager();
      allow delete: if isOwner();
    }

    // Financial transactions
    match /financialTransactions/{transactionId} {
      allow read: if isOwnerOrManager();
      allow create: if isOwnerOrManager();
      allow update: if isOwnerOrManager();
      allow delete: if isOwner();
    }

    // Chat rooms
    match /chatRooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isOwnerOrManager();
    }

    // Chat messages
    match /chatMessages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isOwnerOrManager();
    }

    // Chat typing indicators
    match /chatTyping/{typingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // User presence
    match /userPresence/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Special content
    match /specialContent/{contentId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isOwnerOrManager();
    }

    // Diary entries - dati personali sensibili
    match /diaryEntries/{entryId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated() && (
        isStaff() || request.resource.data.studentId == request.auth.uid
      );
      allow update: if isStaff() || resource.data.studentId == request.auth.uid;
      allow delete: if isStaff() || resource.data.studentId == request.auth.uid;
    }

    // Postural assessments - dati sanitari sensibili
    match /posturalAssessments/{assessmentId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Nutritional consultations
    match /nutritionalConsultations/{consultationId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Academy courses
    match /academyCourses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Academy modules
    match /academyModules/{moduleId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Academy lessons
    match /academyLessons/{lessonId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Academy progress
    match /academyProgress/{progressId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // Academy quizzes
    match /academyQuizzes/{quizId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Academy quiz attempts
    match /academyQuizAttempts/{attemptId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // Academy notes
    match /academyNotes/{noteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Academy ratings
    match /academyRatings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // Academy certificates
    match /academyCertificates/{certId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isStaff() || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isStaff() || resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        isStaff() || resource.data.userId == request.auth.uid
      );
    }

    // KPI targets
    match /kpiTargets/{targetId} {
      allow read: if isAuthenticated();
      allow create: if isOwnerOrManager();
      allow update: if isOwnerOrManager();
      allow delete: if isOwner();
    }

    // Daily tasks
    match /dailyTasks/{taskId} {
      allow read: if isOwnerOrManager();
      allow create: if isOwnerOrManager();
      allow update: if isOwnerOrManager();
      allow delete: if isOwnerOrManager();
    }

    // Custom workout templates
    match /customWorkoutTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Credential change requests
    match /credentialRequests/{requestId} {
      allow read: if isOwnerOrManager() || resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isOwnerOrManager();
      allow delete: if isOwner();
    }

    // Body composition estimates
    match /bodyCompositionEstimates/{estimateId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Gamification
    match /gamification/{gamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // Nutrition team notes
    match /nutritionTeamNotes/{noteId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }
  }
}
