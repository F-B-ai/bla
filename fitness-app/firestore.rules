rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwner() {
      return isAuthenticated() && getUserRole() == 'owner';
    }

    function isOwnerOrManager() {
      return isAuthenticated() && getUserRole() in ['owner', 'manager'];
    }

    function isStaff() {
      return isAuthenticated() && getUserRole() in ['owner', 'manager', 'collaborator'];
    }

    // Check-in accessi palestra (QR/codice alla reception)
    match /checkins/{checkinId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }

    // Stato ESSĒRE (check-in mente-corpo quotidiano)
    match /wellnessChecks/{checkId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }

    // Config di istanza (licenza white-label): sola lettura dai client,
    // scrittura solo dal fornitore via service account (Admin SDK).
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || isOwnerOrManager()
      );
      allow delete: if isStaff();
    }

    // Student invites
    match /studentInvites/{inviteId} {
      allow read: if true;
      allow create: if isStaff();
      allow update: if isAuthenticated();
      allow delete: if isOwnerOrManager();
    }

    // Training programs
    match /trainingPrograms/{programId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Workout plans
    match /workoutPlans/{planId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Exercise library
    match /exerciseLibrary/{exerciseId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Sessions
    match /sessions/{sessionId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // Nutritionist appointments - dati sensibili
    match /nutritionistAppointments/{appointmentId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // Body measurements - dati sanitari sensibili
    match /bodyMeasurements/{measurementId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // BIA documents - dati sanitari sensibili
    match /biaDocuments/{docId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Workout logs
    match /workoutLogs/{logId} {
      allow read: if isAuthenticated() && (
        isStaff() || resource.data.studentId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isStaff() || request.resource.data.studentId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isStaff() || resource.data.studentId == request.auth.uid
      );
      allow delete: if isStaff();
    }

    // Payment plans - dati finanziari sensibili
    match /paymentPlans/{planId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isAuthenticated();
      allow delete: if isOwnerOrManager();
    }

    // Collaborator earnings
    match /collaboratorEarnings/{earningId} {
      allow read: if isOwnerOrManager() || resource.data.collaboratorId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isOwnerOrManager();
      allow delete: if isOwner();
    }

    // Financial transactions
    match /financialTransactions/{transactionId} {
      allow read: if isOwnerOrManager();
      allow create: if isOwnerOrManager();
      allow update: if isOwnerOrManager();
      allow delete: if isOwner();
    }

    // Chat rooms
    match /chatRooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isOwnerOrManager();
    }

    // Chat messages
    match /chatMessages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isOwnerOrManager();
    }

    // Chat typing indicators
    match /chatTyping/{typingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // User presence
    match /userPresence/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Special content
    match /specialContent/{contentId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isOwnerOrManager();
    }

    // Diary entries - dati personali sensibili
    match /diaryEntries/{entryId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated() && (
        isStaff() || request.resource.data.studentId == request.auth.uid
      );
      allow update: if isStaff() || resource.data.studentId == request.auth.uid;
      allow delete: if isStaff() || resource.data.studentId == request.auth.uid;
    }

    // Postural assessments - dati sanitari sensibili
    match /posturalAssessments/{assessmentId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Nutritional consultations
    match /nutritionalConsultations/{consultationId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Academy courses
    match /academyCourses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Academy modules
    match /academyModules/{moduleId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Academy lessons
    match /academyLessons/{lessonId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Academy progress
    match /academyProgress/{progressId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // Academy quizzes
    match /academyQuizzes/{quizId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Academy quiz attempts
    match /academyQuizAttempts/{attemptId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // Academy notes
    match /academyNotes/{noteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Academy ratings
    match /academyRatings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // Academy certificates
    match /academyCertificates/{certId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isStaff() || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isStaff() || resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        isStaff() || resource.data.userId == request.auth.uid
      );
    }

    // KPI targets
    match /kpiTargets/{targetId} {
      allow read: if isAuthenticated();
      allow create: if isOwnerOrManager();
      allow update: if isOwnerOrManager();
      allow delete: if isOwner();
    }

    // Daily tasks
    match /dailyTasks/{taskId} {
      allow read: if isOwnerOrManager();
      allow create: if isOwnerOrManager();
      allow update: if isOwnerOrManager();
      allow delete: if isOwnerOrManager();
    }

    // Custom workout templates
    match /customWorkoutTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Credential change requests
    match /credentialRequests/{requestId} {
      allow read: if isOwnerOrManager() || resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isOwnerOrManager();
      allow delete: if isOwner();
    }

    // Body composition estimates
    match /bodyCompositionEstimates/{estimateId} {
      allow read: if isStaff() || resource.data.studentId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Gamification
    match /gamification/{gamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // Nutrition team notes
    match /nutritionTeamNotes/{noteId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }
  }
}
